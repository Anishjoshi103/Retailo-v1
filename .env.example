# Copy to .env for local development. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-with-a-unique-local-development-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web,nginx
DATABASE_NAME=Retailo
DATABASE_USER=sa
DATABASE_PASSWORD=ReplaceThis_LocalOnly_123!
DATABASE_HOST=db
DATABASE_PORT=1433
# Number of trusted reverse proxies in front of the app (nginx = 1). Rate limits use the client address
# from the right end of X-Forwarded-For; 0 ignores the header. Set it to match your deployment: too low
# makes every user share the proxy's address, too high lets clients spoof their address.
TRUSTED_PROXY_COUNT=0
