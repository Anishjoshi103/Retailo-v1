[Unit]
Description=Retailo nightly SQL Server backup and offsite copy
Wants=network-online.target
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/retailo
EnvironmentFile=-/etc/retailo/backup.env
ExecStart=/usr/bin/bash /opt/retailo/scripts/self-hosted/backup.sh
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
