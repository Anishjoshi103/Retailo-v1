# Copy to .env.prod on the store server. Protect it (chmod 600); never commit it.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=retailo.lan
DJANGO_CSRF_TRUSTED_ORIGINS=https://retailo.lan
FRONTEND_BASE_URL=https://retailo.lan

# Pin every container image by immutable sha256 digest, not a mutable tag.
# Example shape: registry/repository:version@sha256:<64-hex-digest>
API_IMAGE=ghcr.io/anishjoshi103/retailo-api:sha-COMMIT@sha256:REPLACE_WITH_DIGEST
SQLSERVER_IMAGE=mcr.microsoft.com/mssql/server:2022-latest@sha256:REPLACE_WITH_DIGEST
REDIS_IMAGE=redis:7-alpine@sha256:REPLACE_WITH_DIGEST
CADDY_IMAGE=caddy:2-alpine@sha256:REPLACE_WITH_DIGEST

# Set to the fixed LAN IPv4 address assigned to this server by the router.
LAN_BIND_IP=192.168.1.10
RETAILO_HOSTNAME=retailo.lan

DATABASE_NAME=Retailo
DATABASE_PASSWORD=REPLACE_WITH_A_STRONG_SQL_SERVER_SA_PASSWORD
SQLSERVER_MEMORY_LIMIT_MB=2048
SQLSERVER_MEMORY_LIMIT=3G
SQLSERVER_CPU_LIMIT=2.0
REDIS_MAXMEMORY=128mb
REDIS_MEMORY_LIMIT=256M
REDIS_CPU_LIMIT=0.50
API_MEMORY_LIMIT=1G
API_CPU_LIMIT=2.0
PROXY_MEMORY_LIMIT=256M
PROXY_CPU_LIMIT=0.50

SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
TRUST_PROXY_SSL_HEADER=true
TRUSTED_PROXY_COUNT=1
LOG_LEVEL=INFO
